{
  "schema": 2,
  "name": "nb-codex-install",
  "description": "One-time nb-codex install: overwrite the root prompt, write config.toml overlay values, and copy coding agents, the parallel-collab skill, and the model catalog. AGENTS.md is seeded only when absent.",
  "stateFile": ".nb-codex-sync-state.json",
  "modelCatalog": {
    "repo": "models.json",
    "home": "models.json"
  },
  "configPatch": {
    "home": "config.toml",
    "values": [
      { "path": "model_catalog_json", "homePath": "models.json" },
      { "path": "model_instructions_file", "homePath": "prompts/system-prompt-neutral.md" },
      { "path": "agents.max_concurrent_threads_per_session", "value": 15 },
      {
        "path": "features.multi_agent_v2.multi_agent_mode_hint_text",
        "value": "Proactive multi-agent delegation is active; an explicit user request to spawn is not required. Follow the current global AGENTS.md as the single authority for routine ownership, maintained custom-role eligibility, finite topology, and collaboration/verification edge protocols. This mode remains active until a later multi-agent mode developer message changes it."
      }
    ],
    "featureValues": [
      {
        "path": "suppress_unstable_features_warning",
        "feature": "default_mode_request_user_input",
        "value": true
      },
      {
        "path": "features.default_mode_request_user_input",
        "feature": "default_mode_request_user_input",
        "value": true
      }
    ],
    "absent": [
      "stream_idle_timeout_ms",
      "default_mode_request_user_input",
      "features.js_repl"
    ],
    "legacyAgentTables": []
  },
  "agentSets": [
    {
      "id": "prompt-coding",
      "ownership": "full-file",
      "roles": [
        { "name": "executor", "repo": "agents/executor.toml", "home": "agents/executor.toml" },
        { "name": "explore", "repo": "agents/explore.toml", "home": "agents/explore.toml" },
        { "name": "frontend", "repo": "agents/frontend.toml", "home": "agents/frontend.toml" },
        { "name": "implement", "repo": "agents/implement.toml", "home": "agents/implement.toml" },
        { "name": "research", "repo": "agents/research.toml", "home": "agents/research.toml" },
        { "name": "reviewer", "repo": "agents/reviewer.toml", "home": "agents/reviewer.toml" },
        { "name": "think", "repo": "agents/think.toml", "home": "agents/think.toml" }
      ]
    }
  ],
  "files": [
    {
      "repo": "models.json",
      "home": "models.json",
      "diffMode": "summary",
      "description": "Pinned custom Codex model catalog"
    },
    {
      "repo": "agents/executor.toml",
      "home": "agents/executor.toml",
      "description": "Canonical profile for executor"
    },
    {
      "repo": "agents/explore.toml",
      "home": "agents/explore.toml",
      "description": "Canonical profile for explore"
    },
    {
      "repo": "agents/frontend.toml",
      "home": "agents/frontend.toml",
      "description": "Canonical profile for frontend"
    },
    {
      "repo": "agents/implement.toml",
      "home": "agents/implement.toml",
      "description": "Canonical profile for implement"
    },
    {
      "repo": "agents/research.toml",
      "home": "agents/research.toml",
      "description": "Canonical profile for research"
    },
    {
      "repo": "agents/reviewer.toml",
      "home": "agents/reviewer.toml",
      "description": "Canonical profile for reviewer"
    },
    {
      "repo": "agents/think.toml",
      "home": "agents/think.toml",
      "description": "Canonical profile for think"
    },
    {
      "repo": "prompts/subagent-model-instructions.md",
      "home": "prompts/subagent-model-instructions.md",
      "description": "Common baseline prompt for Codex subagents"
    },
    {
      "repo": "prompts/system-prompt-neutral.md",
      "home": "prompts/system-prompt-neutral.md",
      "description": "Root-thread Codex engineering prompt"
    },
    {
      "repo": "skills/codex-parallel-collab/SKILL.md",
      "home": "skills/codex-parallel-collab/SKILL.md",
      "description": "Canonical role-aware parallel collaboration skill"
    },
    {
      "repo": "skills/codex-parallel-collab/LICENSE",
      "home": "skills/codex-parallel-collab/LICENSE",
      "description": "License for the canonical parallel collaboration skill"
    },
    {
      "repo": "skills/codex-parallel-collab/references/subtask-contract.md",
      "home": "skills/codex-parallel-collab/references/subtask-contract.md",
      "description": "Extended successor, repair, recheck, and evidence packet reference"
    },
    {
      "repo": "skills/codex-parallel-collab/references/dispatch-examples.md",
      "home": "skills/codex-parallel-collab/references/dispatch-examples.md",
      "description": "Role-aware collaboration dispatch examples"
    },
    {
      "repo": "skills/codex-parallel-collab/agents/openai.yaml",
      "home": "skills/codex-parallel-collab/agents/openai.yaml",
      "description": "Codex skill metadata for role-aware parallel collaboration"
    }
  ],
  "homeTombstones": []
}
