{
  "schema": 2,
  "name": "nb-codex-install",
  "description": "One-time nb-codex install: overwrite the root prompt, write config.toml overlay values, and copy policies, coding agents, skills, and the model catalog. AGENTS.md is advise-only.",
  "defaultHome": "~/.codex",
  "stateFile": ".nb-codex-sync-state.json",
  "modelCatalog": {
    "repo": "models.json",
    "home": "models.json"
  },
  "configPatch": {
    "home": "config.toml",
    "values": [
      { "path": "model", "value": "gpt-5.6-sol" },
      { "path": "model_reasoning_effort", "value": "xhigh" },
      { "path": "model_auto_compact_token_limit", "value": 345000 },
      { "path": "model_catalog_json", "homePath": "models.json" },
      { "path": "model_instructions_file", "homePath": "prompts/system-prompt-neutral.md" },
      { "path": "service_tier", "value": "default" },
      { "path": "agents.max_concurrent_threads_per_session", "value": 15 },
      {
        "path": "features.multi_agent_v2.multi_agent_mode_hint_text",
        "value": "Proactive multi-agent delegation is active; an explicit user request to spawn is not required. Follow the current global AGENTS.md as the single authority for routine ownership, maintained custom-role eligibility and finite topology, and follow only its named edge-policy routes. Never use the built-in default, explorer, or worker as a fallback. This mode remains active until a later multi-agent mode developer message changes it."
      }
    ],
    "featureValues": [
      {
        "path": "suppress_unstable_features_warning",
        "feature": "default_mode_request_user_input",
        "value": true
      },
      {
        "path": "features.default_mode_request_user_input",
        "feature": "default_mode_request_user_input",
        "value": true
      }
    ],
    "absent": [
      "model_context_window",
      "model_supports_reasoning_summaries",
      "model_reasoning_summary",
      "stream_idle_timeout_ms",
      "default_mode_request_user_input",
      "features.js_repl"
    ],
    "legacyAgentTables": []
  },
  "agentSets": [
    {
      "id": "prompt-coding",
      "ownership": "full-file",
      "roles": [
        { "name": "check", "repo": "agents/check.toml", "home": "agents/check.toml" },
        { "name": "critic", "repo": "agents/critic.toml", "home": "agents/critic.toml" },
        { "name": "explore", "repo": "agents/explore.toml", "home": "agents/explore.toml" },
        { "name": "implement", "repo": "agents/implement.toml", "home": "agents/implement.toml" },
        { "name": "research", "repo": "agents/research.toml", "home": "agents/research.toml" },
        { "name": "think", "repo": "agents/think.toml", "home": "agents/think.toml" },
        { "name": "worker_lite", "repo": "agents/worker-lite.toml", "home": "agents/worker-lite.toml" }
      ]
    }
  ],
  "externalSkills": [],
  "files": [
